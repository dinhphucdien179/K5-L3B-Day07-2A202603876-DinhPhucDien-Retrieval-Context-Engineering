# Copy to .env at the Day07 root; never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=90

# Bonus only: Google's direct API. Use openrouter to reuse that provider.
BONUS_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_REASONING_EFFORT=low
GEMINI_MAX_RETRIES=2
GEMINI_MIN_INTERVAL_SECONDS=6
GEMINI_MAX_INFLIGHT=2

# Only needed for Python outside Docker; Compose sets its own database URL.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

